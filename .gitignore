# =========================
# Gradle / Build
# =========================
.gradle/
build/
**/build/

# Gradle Wrapper는 Git에 포함
!gradle/wrapper/
!gradle/wrapper/gradle-wrapper.jar
!gradle/wrapper/gradle-wrapper.properties

# =========================
# APK / AAB / outputs
# =========================
*.apk
*.aab
*.ap_
*.aar

# =========================
# Android Studio / IntelliJ (전부 무시 — IDE가 재생성)
# =========================
.idea/
*.iml
captures/
.externalNativeBuild/
.cxx/

# =========================
# Local config / secrets
# =========================
local.properties
keystore/
*.jks
*.keystore
*.p12

# properties는 기본적으로 무시하되, 공통 Gradle 설정만 포함
*.properties
!gradle.properties
!gradle/wrapper/gradle-wrapper.properties

# =========================
# Kotlin / temporary
# =========================
.kotlin/

# =========================
# OS files
# =========================
.DS_Store
Thumbs.db

# =========================
# Logs / crash / heap dump
# =========================
*.log
*.hprof
hs_err_pid*
replay_pid*

# Shelved changes
shelf/
*.patch
